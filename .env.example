# ─── Core ─────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_USER=swarm
POSTGRES_PASSWORD=swarm_dev
POSTGRES_DB=swarm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://swarm:swarm_dev@localhost:5432/swarm

# ─── Redis ────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── API / Web ────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8080

# ─── LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-key>
AGENT_MODEL=claude-sonnet-4-6
ARBITER_MODEL=claude-opus-4-6

# ─── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=<your-mapbox-public-token>

# ─── Data source API keys (optional; adapters degrade to public/cached) ───
ACLED_API_KEY=
ACLED_EMAIL=
# ACLED_PASSWORD: required for OAuth2 auth on newer accounts. When set, the
# ACLED adapter exchanges email+password for a bearer token and ignores the
# legacy ?key=&email= URL-param flow.
ACLED_PASSWORD=
FRED_API_KEY=
UN_COMTRADE_KEY=
SEC_EDGAR_USER_AGENT=swarm-research contact@example.com
DATALASTIC_API_KEY=
OPEN_CORPORATES_API_KEY=
# Sayari OAuth2 client_credentials pair (stub adapter; P1):
SAYARI_API_KEY=
SAYARI_CLIENT_SECRET=
