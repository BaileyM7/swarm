{
  "buildCommand": "pnpm build",
  "outputDirectory": ".next/standalone",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN"
  ],
  "envPrefix": "NEXT_PUBLIC_",
  "regions": ["sfo1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
